# Telegram bot token from @BotFather
BOT_TOKEN=

# OpenAI-compatible LLM provider configuration
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=qwen/qwen3.8-27b

# Optional application settings
LOG_LEVEL=INFO
ENVIRONMENT=development

# PostgreSQL and Redis
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/terms_of_reference
REDIS_URL=redis://localhost:6379/0
GENERATION_COST_CREDITS=1
FREE_WELCOME_CREDITS=1
WORKER_MAX_JOBS=10
WORKER_JOB_TIMEOUT_SECONDS=900

# Payment provider (planned infrastructure)
PAYMENT_PROVIDER=yookassa
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
TELEGRAM_PAYMENT_PROVIDER_TOKEN=
